                      <Text style={[styles.todoTypeButtonText, ideaScope === 'personal' && styles.todoTypeButtonTextActive]}>Personal</Text>
                    </TouchableOpacity>
                    <TouchableOpacity
                      style={[styles.todoTypeButton, ideaScope === 'household' && styles.todoTypeButtonActive]}
