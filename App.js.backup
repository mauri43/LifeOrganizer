              ) : (
                <>
                {addItemType === 'ideas' && (
                  <View style={styles.todoTypeSelector}>
                    <TouchableOpacity
                      style={[styles.todoTypeButton, ideaScope === 'personal' && styles.todoTypeButtonActive]}
