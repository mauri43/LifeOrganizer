                {/* Only show title field for restaurants when editing, not when first adding */}
                {!(addItemType === 'restaurants' && !isEditMode) && (
                  <TextInput
                    style={styles.input}
                    placeholder={addItemType === 'restaurants' && isEditMode ? "Restaurant name" : "Item title"}
                    placeholderTextColor="#9CA3AF"
                    value={newItem.title}
